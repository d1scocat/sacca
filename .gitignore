############################
# Python bytecode & caches
############################
__pycache__/
*.py[cod]
*$py.class

############################
# Virtual environments
############################
.venv/
venv/
env/
ENV/

############################
# uv / pip artifacts
############################
# uv.lock is usually COMMITTED for reproducibility
# Uncomment the next line if you explicitly don't want it
# uv.lock

pip-wheel-metadata/
*.egg-info/
.eggs/

############################
